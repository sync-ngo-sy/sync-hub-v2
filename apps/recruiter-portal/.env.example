# Where the API lives. Leave it empty for same-origin, which is both the dev topology
# (the Vite proxy forwards /v1 to localhost:8000) and the production one (portals are
# served same-site with the API so the session cookies stay first-party).
#
# It must not end in /v1 — the generated client's paths already carry that prefix.
VITE_API_BASE_URL=

# How a visitor reaches the Sync team from the landing page. One global contact for the whole
# platform — never a Tenant's own number or address. The WhatsApp number is E.164: a leading +
# and the country code, spaces and hyphens allowed.
#
# Both are optional. A channel that is unset — or set to something that cannot dial or deliver —
# is simply not offered on the landing; nothing else in the portal depends on them.
VITE_CONTACT_WHATSAPP=+963944123456
VITE_CONTACT_EMAIL=hello@sync.ngo

# Where platform admins should continue when they reach this portal. Defaults to its dev server.
VITE_ADMIN_PORTAL_URL=http://localhost:5175

# The origin a Tracked link's shareable address is built on: a Candidate who opens one lands in
# the Candidate Portal, which is where the view gets counted. Defaults to its dev server.
VITE_CANDIDATE_PORTAL_URL=http://localhost:5173
