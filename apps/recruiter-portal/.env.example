# Copy to `.env` only if you need to override the default.
#
# Where the API lives. Empty — the default when the variable is absent — means same-origin:
# the Vite dev proxy forwards `/v1` to localhost:8000, and production serves this portal
# same-site with the API so the session cookies stay first-party.
#
# Must not end in `/v1`: the generated client's paths already carry that prefix.
VITE_API_BASE_URL=

# How the public landing lets a company reach the Sync team — one global contact, never
# per-company details. Dev and tests fall back to a placeholder when unset, so a fresh checkout
# runs; a production build refuses to start without both, so it never ships a placeholder.
#
# International number, digits only (no `+`, no leading 0) — what `wa.me` expects.
VITE_CONTACT_WHATSAPP=963991234567
# The inbox a "Contact us" mail opens.
VITE_CONTACT_EMAIL=hello@sync.ngo
