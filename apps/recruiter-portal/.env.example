# Copy to `.env` only if you need to override the default.
#
# Where the API lives. Empty — the default when the variable is absent — means same-origin:
# the Vite dev proxy forwards `/v1` to localhost:8000, and production serves this portal
# same-site with the API so the session cookies stay first-party.
#
# Must not end in `/v1`: the generated client's paths already carry that prefix.
VITE_API_BASE_URL=
