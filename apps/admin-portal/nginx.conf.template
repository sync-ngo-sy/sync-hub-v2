server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    include /etc/nginx/security-headers.conf;

    # Vite fingerprints these, so the name changes whenever the bytes do.
    # No `expires` alongside this: it emits a Cache-Control of its own and the response would
    # carry the header twice.
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /robots.txt {
        include /etc/nginx/security-headers.conf;
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Client-side routing: every unknown path is a route, not a missing file. index.html itself is
    # never cached, or a deploy would keep serving links to assets that no longer exist.
    location / {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files $uri /index.html;
    }
}
