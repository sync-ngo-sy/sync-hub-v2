server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    # A staff portal has no business in a search index, in either environment. IAP hides it from
    # the internet anyway; this is the belt to that braces, and it costs nothing.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Vite fingerprints these, so the name changes whenever the bytes do.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Client-side routing: every unknown path is a route, not a missing file. index.html itself is
    # never cached, or a deploy would keep serving links to assets that no longer exist.
    location / {
        add_header Cache-Control "no-store" always;
        try_files $uri /index.html;
    }
}
