# Where the API lives. Leave it empty for same-origin, which is both the dev topology
# (the Vite proxy forwards /v1 to localhost:8000) and the production one (portals are
# served same-site with the API so the session cookies stay first-party).
#
# It must not end in /v1 — the generated client's paths already carry that prefix.
VITE_API_BASE_URL=
