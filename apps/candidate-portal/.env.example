# Where the API lives. Empty means same-origin, which is the dev topology: the Vite proxy
# forwards /v1 to localhost:8000.
#
# Deployed, this is set to the API's own hostname — https://api.sync.ngo, or the -staging one
# — so every authenticated request is cross-origin. The session cookie still attaches because
# both are subdomains of one registrable domain and SameSite=Lax does not need a shared cookie
# domain; the API's CORS allowlist has to name this portal's origin. See ADR-0005 and ADR-0016.
#
# It must not end in /v1 — the generated client's paths already carry that prefix.
VITE_API_BASE_URL=

# Where the Recruiter Portal lives. The landing's "For employers" links lead there, and it
# is always a different origin from this portal. Defaults to its dev server.
VITE_RECRUITER_PORTAL_URL=http://localhost:5174

# Where platform admins should continue when they reach this portal. Defaults to its dev server.
VITE_ADMIN_PORTAL_URL=http://localhost:5175
