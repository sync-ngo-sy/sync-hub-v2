# Copy to `services/api/.env` for local development, then fill the two keys from
# `supabase status`. Nothing here is a real credential, and `.env` is git-ignored —
# deployments supply these as environment variables instead.

SYNC_ENVIRONMENT=local

# Direct Postgres connection with the service role (ADR-0004). Must use the asyncpg driver.
SYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# Supabase, used only as a GoTrue/Storage HTTP client.
SYNC_SUPABASE_URL=http://127.0.0.1:54321
SYNC_SUPABASE_SERVICE_ROLE_KEY=copy-SERVICE_ROLE_KEY-from-supabase-status
SYNC_SUPABASE_ANON_KEY=copy-ANON_KEY-from-supabase-status

# Auth (ADR-0005). Session cookies are `Secure`, which a browser will not send over plain
# HTTP — so local development, and only local development, turns that off.
SYNC_AUTH_COOKIE_SECURE=false
# `lax` unless the SPAs are served from a different site than the API, which they are not.
SYNC_AUTH_COOKIE_SAME_SITE=lax
# Unset means host-only cookies. Set it only to share a session across subdomains.
# SYNC_AUTH_COOKIE_DOMAIN=.sync.example
# Per client address, per auth endpoint.
SYNC_AUTH_RATE_LIMIT_MAX_REQUESTS=20
SYNC_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Where teammate invite emails land. Must be listed in `additional_redirect_urls` in
# `supabase/config.toml`, or GoTrue quietly sends the invite to the candidate portal instead.
SYNC_RECRUITER_PORTAL_URL=http://127.0.0.1:5174

# CV extraction (ADR-0006). Only the worker process reads these — the API never calls the
# model, and the test suite parses with the fake extractor, so leaving the key unset is fine
# until you want to run the `ai_live` tests or parse a CV for real.
# SYNC_OPENAI_API_KEY=sk-...
SYNC_OPENAI_CV_MODEL=gpt-4o-mini

SYNC_LOG_LEVEL=INFO
# `console` is the readable local format; deployments leave this as `json`.
SYNC_LOG_FORMAT=console
