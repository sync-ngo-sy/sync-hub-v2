# Copy to `services/api/.env` for local development, then fill the two keys from
# `supabase status`. Nothing here is a real credential, and `.env` is git-ignored —
# deployments supply these as environment variables instead.

SYNC_ENVIRONMENT=local

# Direct Postgres connection with the service role (ADR-0004). Must use the asyncpg driver.
SYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# Supabase, used only as a GoTrue/Storage HTTP client.
SYNC_SUPABASE_URL=http://127.0.0.1:54321
SYNC_SUPABASE_SERVICE_ROLE_KEY=copy-SERVICE_ROLE_KEY-from-supabase-status
SYNC_SUPABASE_ANON_KEY=copy-ANON_KEY-from-supabase-status

# Auth (ADR-0005). Session cookies are `Secure`, which a browser will not send over plain
# HTTP — so local development, and only local development, turns that off.
SYNC_AUTH_COOKIE_SECURE=false
# `lax` is enough even deployed: the portals are a different origin from the API but the same
# site, so the cookie still travels without any shared cookie domain.
SYNC_AUTH_COOKIE_SAME_SITE=lax
# Leave unset — host-only. Sharing a session across subdomains would also share it between
# staging and production, so deployed environments refuse to start with this set.
# SYNC_AUTH_COOKIE_DOMAIN=
# Per client address, per auth endpoint.
SYNC_AUTH_RATE_LIMIT_MAX_REQUESTS=20
SYNC_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Where teammate invite emails land. Must be listed in `additional_redirect_urls` in
# `supabase/config.toml`, or GoTrue quietly sends the invite to the candidate portal instead.
SYNC_RECRUITER_PORTAL_URL=http://127.0.0.1:5174
# Where Platform-admin recovery emails land. It follows the same GoTrue allowlist rule.
SYNC_ADMIN_PORTAL_URL=http://127.0.0.1:5175

# The public job board has no account behind it, so it gets its own budget: per client
# address, per route (reading a thousand jobs spends one budget, not a thousand).
SYNC_PUBLIC_RATE_LIMIT_MAX_REQUESTS=120
SYNC_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
# What a job view's visitor hash is salted with. Unset, it falls back to the service-role
# key — already per-deployment, so the hashes are never reversible with a rainbow table.
# SYNC_VISITOR_HASH_SALT=any-long-random-string

# Asking for access is the only unauthenticated write there is, and it goes nowhere near the
# identity provider, so none of GoTrue's own limits cover it. A company asks once; anything
# submitting by the handful is a script filling the Platform admin's queue.
SYNC_ACCESS_REQUEST_RATE_LIMIT_MAX_REQUESTS=5
SYNC_ACCESS_REQUEST_RATE_LIMIT_WINDOW_SECONDS=3600

# Candidate discovery, counted per Tenant. Paging the directory to the end is how the whole
# contact database walks out of the door, so both routes carry a minute's budget and a day's:
# a script that stays under a per-minute limit still cannot finish inside a day. Reading one
# Candidate is the only way to get an email address or a phone number, so it gets the tightest
# budget of the two, and every read of it is logged.
SYNC_DIRECTORY_RATE_LIMIT_MAX_REQUESTS=60
SYNC_DIRECTORY_RATE_LIMIT_WINDOW_SECONDS=60
SYNC_DIRECTORY_RATE_LIMIT_DAILY_MAX_REQUESTS=1500
SYNC_CANDIDATE_RECORD_RATE_LIMIT_MAX_REQUESTS=20
SYNC_CANDIDATE_RECORD_RATE_LIMIT_WINDOW_SECONDS=60
SYNC_CANDIDATE_RECORD_RATE_LIMIT_DAILY_MAX_REQUESTS=200

# CV extraction (ADR-0006), profile embedding, and AI match assessments. The worker needs the
# key to parse a CV or embed a profile; the API needs it to embed a search query and to assess
# an application, and answers 503 on those two endpoints without it. The test suite uses fakes
# for all three, so leaving it unset is fine until you want to run the `ai_live` tests or parse
# a CV for real.
# SYNC_OPENAI_API_KEY=sk-...
SYNC_OPENAI_CV_MODEL=gpt-4o-mini
SYNC_OPENAI_ASSESSMENT_MODEL=gpt-4o-mini
SYNC_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Assessments cost money per call, so they carry a budget of their own — counted per tenant,
# because the recruiters of one tenant share the bill for what they ask for.
SYNC_ASSESSMENT_RATE_LIMIT_MAX_REQUESTS=20
SYNC_ASSESSMENT_RATE_LIMIT_WINDOW_SECONDS=60
# Global search embeds every question it is asked, so it spends the model budget as well as
# reading the pool. Per Tenant, for both reasons.
SYNC_SEARCH_RATE_LIMIT_MAX_REQUESTS=30
SYNC_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
SYNC_SEARCH_RATE_LIMIT_DAILY_MAX_REQUESTS=600
# Every CV upload queues a parse the platform pays a model for. Per acting profile, because an
# upload is one Candidate's own and no account may spend on another's budget.
SYNC_CV_UPLOAD_RATE_LIMIT_MAX_REQUESTS=5
SYNC_CV_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
SYNC_CV_UPLOAD_RATE_LIMIT_DAILY_MAX_REQUESTS=30

# Sending queued Communications. Same arrangement as the OpenAI key: the worker refuses to
# start without it, the API never reads it, and the suite delivers through a capturing fake
# unless you run the `email_live` tests. `SYNC_EMAIL_FROM` needs a domain verified with
# Resend; the default is their sandbox sender, which only reaches their own test addresses.
# SYNC_RESEND_API_KEY=re_...
# SYNC_EMAIL_FROM=Sync Hub <noreply@sync.example>

# What the database webhook and the schedule authenticate the worker's drain endpoints with.
# Neither caller can mint a Google identity token, so this stands in for IAM. The service
# refuses to serve at all without it rather than exposing an unauthenticated drain, which
# would be a free way to spend someone else's model budget. Any long random string.
# SYNC_WORKER_SHARED_SECRET=
# Ceiling on one invocation, so a queue being fed faster than it drains cannot keep a request
# alive until the platform kills it mid-job. Stopping early is safe; the schedule calls again.
SYNC_WORKER_DRAIN_MAX_ROWS=500

# Origins allowed to call the API from a browser, comma separated. Empty locally, where the dev
# server proxies and nothing is cross-origin. Deployed, this is the portals' hostnames and
# nothing else -- a wildcard is refused, and so is a trailing slash, since a browser's Origin
# header never has a path and the comparison is literal.
# SYNC_CORS_ALLOWED_ORIGINS=https://jobs.sync.ngo,https://app.sync.ngo

SYNC_LOG_LEVEL=INFO
# `console` is the readable local format; deployments leave this as `json`.
SYNC_LOG_FORMAT=console
