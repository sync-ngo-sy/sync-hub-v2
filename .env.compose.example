# Copy to `.env` at the repo root, for `docker compose`. The API and worker read it as-is, so
# leave a key out entirely rather than setting it empty — an empty value is a value, and the
# process will try to use it.
#
# Fill the two keys from `supabase status -o env`:
#   SYNC_SUPABASE_ANON_KEY         <- ANON_KEY
#   SYNC_SUPABASE_SERVICE_ROLE_KEY <- SERVICE_ROLE_KEY
#
# `SYNC_DATABASE_URL` and `SYNC_SUPABASE_URL` are set by `compose.yaml` and belong in neither
# this file nor the environment: inside the stack's network the hostnames differ from the host's.

SYNC_SUPABASE_ANON_KEY=copy-ANON_KEY-from-supabase-status
SYNC_SUPABASE_SERVICE_ROLE_KEY=copy-SERVICE_ROLE_KEY-from-supabase-status

# Where teammate invite emails land. Must be listed in `additional_redirect_urls` in
# `supabase/config.toml`.
SYNC_RECRUITER_PORTAL_URL=http://127.0.0.1:5174

SYNC_LOG_LEVEL=INFO

# Which host port the API is published on.
SYNC_API_PORT=8000

# CV parsing, profile embedding and match assessments. Leave commented out until you want them:
# the worker logs a parse it cannot do, and the API answers 503 on search and assessment.
# SYNC_OPENAI_API_KEY=sk-...

# Sending queued Communications. The worker refuses to start without it.
# SYNC_RESEND_API_KEY=re_...
# SYNC_EMAIL_FROM=Sync <noreply@sync.example>
