Project recruitment_platform {
  database_type: 'PostgreSQL'
  Note: '''
    Lean recruitment platform schema using Supabase.

    Live email is owned by Supabase Auth and is available only to trusted backend
    services. Live name, avatar and phone are owned by profiles. Application-time
    identity and professional data are retained in immutable application snapshots.

    A CV stores immutable AI ParsedCv JSON output. Candidate-confirmed data may be
    used for one application without changing the global profile, or may update the
    global profile only when the candidate explicitly chooses that option.

    When the candidate applies, the application and its normalized application_* profile snapshot rows
    are created atomically. Screening always reads those immutable application-time rows, so later profile
    edits never change an earlier qualification result.

    Only the candidate may edit or confirm candidate-owned profile data. Recruiters have read-only access.

    --------------------------------------------------------------------------
    CURRENT LEAN-MVP DECISIONS
    --------------------------------------------------------------------------
    1. Supabase Auth is the only email source; application snapshots never store email.
    2. current_cv_id is nullable during onboarding and required by trusted operations
       before a candidate becomes searchable or applies from the global profile.
    3. Global-profile and alternate-CV flows initialize the same review form and create
       the same source-agnostic application snapshot.
    4. Screening is deterministic: total experience, required skills and skill years,
       required languages, and yes/no knockout answers. There is no match score.
    5. Screening criteria and application questions lock after the first application.
    6. Recruiter notes, tags and communication history are shared within the tenant.
    7. Recruiter-initiated communication is allowed only for an existing application.
    8. Global candidate search is explicit opt-in and never exposes email or phone.
    9. PostgreSQL-only CHECK constraints and triggers listed in notes MUST be created
       in application migrations; DBML emits those notes as comments, not constraints.
  '''
}

/* -------------------------------------------------------------------------- */
/* Enums                                                                       */
/* -------------------------------------------------------------------------- */

Enum recruiter_role {
  admin
  recruiter
}

Enum tenant_plan {
  free
  pro
  enterprise
}

Enum job_status {
  draft
  published
  closed
  archived
}

Enum skill_importance {
  required
  preferred
  optional
}

Enum cv_parsing_status {
  uploaded
  processing
  ready
  failed
}

Enum ingestion_status {
  pending
  processing
  completed
  failed
}

Enum application_status {
  new
  reviewing
  shortlisted
  interview
  offer
  hired
  rejected
  withdrawn
}

Enum application_question_type {
  yes_no
  short_text
}

Enum status_change_source {
  recruiter
  candidate
  system
}

Enum qualification_status {
  pending
  qualified
  disqualified
  review_required
}

Enum communication_channel {
  email
  sms
}

Enum communication_status {
  queued
  processing
  sent
  failed
}


Enum communication_type {
  application_confirmation
  application_rejection
  application_status_update
  ingestion_failure
  general
}

Enum language_proficiency {
  beginner
  intermediate
  advanced
  fluent
  native
}

Enum tag_scope {
  candidate
  application
}


/* -------------------------------------------------------------------------- */
/* Identity                                                                    */
/* -------------------------------------------------------------------------- */

Table auth.users {
  id uuid [pk]
  email varchar

  Note: '''
    Managed by Supabase Auth. The application requires email-based candidate
    accounts. Trusted backend services read the current verified email when
    sending communications. Do not create this table in application migrations.
  '''
}
Table profiles {
  id uuid [pk]

  full_name varchar [not null]
  avatar_url text

  phone varchar

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: '''
    Authoritative live source for full_name, avatar_url and phone. Email is not
    stored here; trusted backend services read the verified email from auth.users.

    Recruiters do not directly read this table for global candidate search. A
    trusted search view or endpoint exposes only permitted public fields and never
    exposes phone. Recruiters viewing an application use the immutable submitted
    identity in application_profile_snapshots.

    Soft-delete: deleted_at marks the profile inactive. Readers MUST filter deleted_at IS NULL.
  '''
}

Table candidates {
  id uuid [pk]

  current_cv_id uuid [
    note: '''
      NULL while onboarding is incomplete. Before global-profile application or
      global search, it must reference this candidate's non-deleted CV whose
      parsing_status is ready. ON DELETE is RESTRICT because CVs are soft-deleted.
    '''
  ]

  profile_version int [
    not null,
    default: 1,
    note: 'Increment whenever any non-contact candidate profile field changes. This is not a historical revision.'
  ]

  headline varchar
  summary text
  location varchar

  preferred_language_code varchar [
    note: 'Preferred product or communication language, not the candidate proficiency level.'
  ]

  is_searchable boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    current_cv_id
  }
  

  Note: '''
    Authoritative current non-contact profile root.
    Only the candidate may update these profile fields.
    Name, phone and avatar always come from profiles.

    Global search eligibility is enforced by a trusted view or endpoint. A candidate
    is returned only when all of the following hold:
      - candidates.is_searchable = true;
      - candidates.deleted_at IS NULL and profiles.deleted_at IS NULL;
      - current_cv_id IS NOT NULL;
      - the current CV has parsing_status = ready and deleted_at IS NULL; and
      - candidate_profile_chunks.profile_version = candidates.profile_version.

    The global-search projection may expose approved professional fields, full_name
    and avatar, but must not expose auth.users.email or profiles.phone. It also never
    exposes another tenant's notes, tags, communications or applications.

    profile_version integrity:
      profile_version must be bumped whenever ANY non-contact field changes here OR in
      candidate_experiences / candidate_educations / candidate_skills / candidate_projects /
      candidate_languages. This MUST be enforced by DB triggers on every one of those tables
      (AFTER INSERT/UPDATE/DELETE), not by application code, otherwise candidate_profile_chunks
      will silently serve embeddings against a version that no longer matches the profile.

    Soft-delete: deleted_at marks the candidate inactive. Child candidate_* rows are hard
    rows (no deleted_at); readers of the profile MUST filter candidates.deleted_at IS NULL
    at the root. Removed the standalone profile_version index (no all-candidates-at-version-N
    access pattern).
    PostgreSQL migration constraints:
      CHECK (NOT is_searchable OR current_cv_id IS NOT NULL)

    The trusted global-profile application RPC additionally verifies that current_cv_id
    points to a ready, non-deleted CV before accepting the submission.
  '''
}

/* -------------------------------------------------------------------------- */
/* Tenants and recruiters                                                      */
/* -------------------------------------------------------------------------- */

Table tenants {
  id uuid [pk]

  name varchar [not null]
  slug varchar [not null, unique]

  plan tenant_plan [not null, default: 'free']
  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
}

Table recruiters {
  id uuid [pk]
  tenant_id uuid [not null]

  role recruiter_role [not null, default: 'recruiter']
  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
    (tenant_id, id) [unique]
  }

  Note: '''
    Single-tenant by construction: recruiters.id = profiles.id = auth.users.id, and tenant_id
    is a single column, so one human cannot be a recruiter at two tenants. This is a deliberate
    "lean" choice, NOT changed in this revision. Converting to multi-tenant recruiters would
    require breaking the profiles.id = recruiters.id shared PK and introducing a membership table.

    Recruiters are never hard-deleted (is_active = false instead); this keeps the NOT NULL
    recruiter_id FKs on notes / tags / pools valid.
  '''
}

/* -------------------------------------------------------------------------- */
/* Jobs and skill taxonomy                                                     */
/* -------------------------------------------------------------------------- */

Table jobs {
  id uuid [pk]

  tenant_id uuid [not null]
  created_by_recruiter_id uuid [not null]

  title varchar [not null]
  description text [not null]

  location varchar
  employment_type varchar
  minimum_total_experience_years decimal(4,1) [
  note: 'Optional minimum total professional experience.'
  ]

  status job_status [not null, default: 'draft']
  expires_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, status)
    (tenant_id, id) [unique]
    created_by_recruiter_id
    (status, expires_at)
  }

  Note: '''
    (tenant_id, id) is unique so applications can composite-FK the job and inherit its tenant.

    Screening-criteria editing rule, enforced by trusted job-management operations:
      - Draft job: all criteria and questions are editable.
      - Published job with no applications: criteria and questions remain editable.
      - After the first application: minimum_total_experience_years, job_skills,
        job_languages and job_application_questions are locked.
      - A material criteria change after that point requires duplicating the job.

    Education is retained for recruiter review and semantic search but is not an
    automatic screening criterion.

    PostgreSQL migration constraint:
      CHECK (
        minimum_total_experience_years IS NULL OR
        minimum_total_experience_years >= 0
      )
  '''
}

Table skill_categories {
  id uuid [pk]

  name varchar [not null, unique]

  created_at timestamptz [not null, default: `now()`]
}

Table skill_taxonomy {
  id uuid [pk]

  category_id uuid [not null]
  canonical_name varchar [not null, unique]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    category_id
  }

  Note: '''
    Seeded canonical MVP skill list. The CV parser receives this list and may
    return only canonical skills. Unknown skills are discarded for the MVP, the
    candidate reviews the mapped result, and the original AI output remains in
    cvs.parsed_cv_data for traceability and future remapping.
  '''
}

Table job_skills {
  id uuid [pk]

  job_id uuid [not null]
  taxonomy_id uuid [not null]

  importance skill_importance [not null, default: 'preferred']
  minimum_years int

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (job_id, taxonomy_id) [unique]
    taxonomy_id
  }

  Note: '''
    CHECK constraints (add in migration):
      CHECK (minimum_years IS NULL OR minimum_years >= 0)
  '''
}

Table languages {
  code varchar [
    pk,
    note: 'ISO language code such as en, ar or fr.'
  ]

  name varchar [not null, unique]
}

Table job_languages {
  job_id uuid [not null]
  language_code varchar [not null]

  minimum_proficiency language_proficiency [not null]

  indexes {
    (job_id, language_code) [pk]
  }

  Note: '''
    Required language criteria for deterministic screening. An application that
    omits the language or reports a lower proficiency is disqualified.
  '''
}

Table job_application_questions {
  id uuid [pk]
  job_id uuid [not null]

  question_text text [not null]
  question_type application_question_type [not null]

  is_required boolean [not null, default: true]

  accepted_boolean_answer boolean [
    note: '''
      Valid only for yes_no questions. NULL means the question is not an
      automatic knockout criterion. A different submitted answer disqualifies.
    '''
  ]

  sort_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (job_id, id) [unique]
    (job_id, sort_order)
  }

  Note: '''
    MVP questions are either yes/no or short text. Only yes/no questions may
    participate in automatic screening.

    PostgreSQL migration constraints:
      CHECK (question_type = 'yes_no' OR accepted_boolean_answer IS NULL)
      CHECK (sort_order >= 0)

    Questions are locked with the other screening criteria after the first
    application. Trusted job-management operations enforce that rule.
  '''
}

/* -------------------------------------------------------------------------- */
/* CV parsing                                                                  */
/* -------------------------------------------------------------------------- */

Table cvs {
  id uuid [pk]
  candidate_id uuid [not null]

  display_name varchar [not null]
  storage_path text [not null]

  file_hash varchar [
    not null,
    note: 'SHA-256 hexadecimal value.'
  ]

  detected_language varchar

  parsed_cv_schema_version int [
    not null,
    default: 1,
    note: 'Version of the ParsedCv contract used to validate parsed_cv_data.'
  ]

  parsed_cv_data jsonb [
    note: '''
      Immutable validated ParsedCv output produced by the AI for this document.
      It contains CV-derived fields such as summary, education, experience, projects, skills and languages.
      It is not the authoritative source for full_name or phone.
    '''
  ]

  parsing_status cv_parsing_status [
    not null,
    default: 'uploaded',
    note: 'AUTHORITATIVE parsing state. All application/candidate readers use THIS column, never ingestion_jobs.status.'
  ]
  parsing_error text
  parsed_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    // Prevents the candidate from uploading the exact same file twice.
    (candidate_id, file_hash) [unique]

    // Supports ownership checks from candidates and applications.
    (candidate_id, id) [unique]

    (candidate_id, parsing_status)
  }

 Note: '''
  A CV row is an immutable document record after parsing succeeds.

  parsed_cv_data is the original AI proposal shown in the review form.

  After review, the candidate may either:

  1. Use the confirmed data only for an application, in which case it is
     written directly into application_* tables and candidate_* is unchanged.

  2. Update the global profile, in which case it is written into candidate_*
     and may also be copied into application_* when applying.

  The original parsed_cv_data remains unchanged for traceability.

  parsing_status is the ONLY authoritative status. ingestion_jobs is queue plumbing;
  its status is an internal worker detail and is never read for product logic.

  Soft-delete: CVs are soft-deleted via deleted_at, never hard-deleted, so that
  applications.cv_id and candidates.current_cv_id FKs remain valid. Readers MUST
  filter deleted_at IS NULL.
'''
}

Table ingestion_jobs {
  id uuid [pk]
  cv_id uuid [not null, unique]

  status ingestion_status [not null, default: 'pending']
  attempts int [not null, default: 0]

  error_message text

  available_at timestamptz
  started_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (status, available_at)
  }

  Note: '''
    QUEUE MECHANICS ONLY. This table drives the parsing worker (retries, backoff via
    available_at, attempt counting). It is NOT a source of truth for CV state:
    cvs.parsing_status is authoritative and is what every reader consumes. The worker
    updates cvs.parsing_status as the last step of each transition so the two never
    need to be joined by readers.

    CHECK constraints (add in migration):
      CHECK (attempts >= 0)
  '''
}

/* -------------------------------------------------------------------------- */
/* Current candidate profile                                                   */
/* -------------------------------------------------------------------------- */

Table candidate_experiences {
  id uuid [pk]
  candidate_id uuid [not null]

  company_name varchar
  job_title varchar [not null]

  start_year int
  start_month int
  end_year int
  end_month int

  is_current boolean [not null, default: false]
  description text
  sort_order int [not null, default: 0]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    candidate_id
    (candidate_id, start_year)
    (candidate_id, sort_order)
  }

  Note: '''
    Current candidate-owned data. Only the candidate may insert, update or delete rows.
    Changes here MUST bump candidates.profile_version (enforce via trigger).

    CHECK constraints (add in migration):
      CHECK (start_month IS NULL OR start_month BETWEEN 1 AND 12)
      CHECK (end_month   IS NULL OR end_month   BETWEEN 1 AND 12)
      CHECK (start_year  IS NULL OR start_year BETWEEN 1900 AND 2100)
      CHECK (end_year    IS NULL OR end_year   BETWEEN 1900 AND 2100)
      -- ordering when both endpoints are present
      CHECK (start_year IS NULL OR end_year IS NULL OR
             (end_year > start_year) OR
             (end_year = start_year AND COALESCE(end_month,12) >= COALESCE(start_month,1)))
      -- a current role cannot also have an end date
      CHECK (NOT is_current OR (end_year IS NULL AND end_month IS NULL))
  '''
}

Table candidate_educations {
  id uuid [pk]
  candidate_id uuid [not null]

  institution varchar [not null]
  degree varchar
  field_of_study varchar
  graduation_year int

  description text
  sort_order int [not null, default: 0]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    candidate_id
    (candidate_id, graduation_year)
    (candidate_id, sort_order)
  }

  Note: '''
    Current candidate-owned data. Only the candidate may insert, update or delete rows.
    Changes here MUST bump candidates.profile_version (enforce via trigger).

    CHECK constraints (add in migration):
      CHECK (graduation_year IS NULL OR graduation_year BETWEEN 1900 AND 2100)
  '''
}

Table candidate_skills {
  candidate_id uuid [not null]
  taxonomy_id uuid [not null]

  years_experience decimal(4,1) [
    note: 'Optional candidate-confirmed value used when a job requires minimum years for a skill.'
  ]

  sort_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (candidate_id, taxonomy_id) [pk]
    (taxonomy_id, candidate_id)
    (candidate_id, sort_order)
  }

  Note: '''
    Current candidate-owned data. Only the candidate may insert, update or delete rows.
    Changes here MUST bump candidates.profile_version (enforce via trigger).

    CHECK constraints (add in migration):
      CHECK (years_experience IS NULL OR years_experience >= 0)
  '''
}

Table candidate_projects {
  id uuid [pk]
  candidate_id uuid [not null]

  name varchar [not null]
  description text

  project_url text
  repository_url text

  start_year int
  start_month int
  end_year int
  end_month int

  sort_order int [not null, default: 0]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    candidate_id
    (candidate_id, sort_order)
  }

  Note: '''
    Current candidate-owned data. Only the candidate may insert, update or delete rows.
    Changes here MUST bump candidates.profile_version (enforce via trigger).

    CHECK constraints (add in migration):
      CHECK (start_month IS NULL OR start_month BETWEEN 1 AND 12)
      CHECK (end_month   IS NULL OR end_month   BETWEEN 1 AND 12)
      CHECK (start_year IS NULL OR end_year IS NULL OR
             (end_year > start_year) OR
             (end_year = start_year AND COALESCE(end_month,12) >= COALESCE(start_month,1)))
  '''
}

Table candidate_languages {
  candidate_id uuid [not null]
  language_code varchar [not null]

  proficiency language_proficiency [not null]
  sort_order int [not null, default: 0]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (candidate_id, language_code) [pk]
    (language_code, candidate_id)
    (candidate_id, sort_order)
  }

  Note: '''
    Current candidate-owned data. Only the candidate may insert, update or delete rows.
    Changes here MUST bump candidates.profile_version (enforce via trigger).
  '''
}

Table candidate_profile_chunks {
  id uuid [pk]

  candidate_id uuid [not null]
  profile_version int [not null]

  chunk_type varchar
  chunk_text text [not null]
  chunk_index int [not null]

  embedding vector [
    note: 'Use the selected embedding model dimension in the PostgreSQL migration.'
  ]

  embedding_model varchar [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (candidate_id, profile_version, chunk_index) [unique]
    (candidate_id, profile_version)
  }

  Note: '''
    Generated from the candidate's current normalized profile.
    Global search uses rows matching candidates.profile_version.

    GC: rows for superseded profile_versions become dead weight (they are never queried
    once candidates.profile_version advances). A background job MUST delete chunks where
    profile_version < candidates.profile_version to keep the vector index from bloating.
  '''
}

/* -------------------------------------------------------------------------- */
/* Applications                                                                */
/* -------------------------------------------------------------------------- */


Table applications {
  id uuid [pk]

  tenant_id uuid [
    not null,
    note: 'Denormalized from the job so tenant isolation is enforceable by composite FKs, not only RLS. Must equal jobs.tenant_id'
  ]

  candidate_id uuid [not null]
  job_id uuid [not null]

  cv_id uuid [
  not null,
  note: '''
    Exact CV attached to the application. In the global-profile flow this is
    candidates.current_cv_id; in the alternate-CV flow it is the selected CV.
    The final candidate-reviewed data is stored in the application_* snapshot
    tables, is source-agnostic, and may differ from cvs.parsed_cv_data.
  '''
  ]

  tracked_link_id uuid [
  note: 'NULL for applications submitted through the ordinary untracked job URL.'
]

  status application_status [not null, default: 'new']

  qualification_status qualification_status [
    not null,
    default: 'pending',
    note: 'CURRENT denormalized screening verdict. The authoritative, auditable trail lives in application_qualification_history.'
  ]
  qualification_reason text

  applied_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (candidate_id, job_id) [unique]
    (job_id, status)
    (job_id, id) [unique]
    (tenant_id, id) [unique]
    (id, candidate_id) [unique]
    (job_id, tracked_link_id)
    cv_id
  }

 Note: '''
  Created only when the candidate submits the reviewed application form.

  Before submission, parsed and edited data exists only in client form state
  and may optionally be cached in browser storage.

  On submission, applications and all application_* snapshot rows are created
  atomically. These rows are immutable after creation and are the authoritative
  screening input.

  cvs.parsed_cv_data remains the immutable original AI output and may differ
  from the candidate-reviewed application data.

  The submission RPC verifies that cv_id belongs to the candidate, is not
  deleted and has parsing_status = ready.

  Deterministic screening rules:
    - a required skill is absent: disqualified;
    - required-skill years below the minimum: disqualified;
    - unknown years for a required skill: review_required;
    - total experience is below the minimum: disqualified;
    - total experience cannot be calculated reliably: review_required;
    - a required language is absent or below minimum proficiency: disqualified;
    - a yes/no knockout answer differs from accepted_boolean_answer: disqualified;
    - every mandatory criterion passes: qualified.

  Preferred and optional skills never disqualify. Screening does not calculate
  a match score; semantic-search similarity remains separate search metadata.
'''
}

Table application_profile_snapshots {
  full_name varchar [not null]
  phone varchar
  application_id uuid [pk]
  headline varchar
  summary text
  location varchar

  captured_at timestamptz [not null, default: `now()`]

  Note: '''
    Immutable identity and application-specific professional data submitted by
    the candidate. It may originate from the global profile or a reviewed
    alternate-CV form; the snapshot does not record or depend on that source.
    Candidate and recruiter edits are prohibited after submission.
  '''
}

Table application_experiences {
  id uuid [pk]
  application_id uuid [not null]

  company_name varchar
  job_title varchar [not null]

  start_year int
  start_month int
  end_year int
  end_month int

  is_current boolean [not null, default: false]
  description text
  sort_order int [not null, default: 0]

  indexes {
    application_id
    (application_id, start_year)
    (application_id, sort_order)
  }

  Note: '''
    Immutable application-time experience data used for screening. It may
    originate from the global profile or a reviewed alternate-CV form.

    CHECK constraints (add in migration):
      CHECK (start_month IS NULL OR start_month BETWEEN 1 AND 12)
      CHECK (end_month   IS NULL OR end_month   BETWEEN 1 AND 12)
      CHECK (start_year IS NULL OR end_year IS NULL OR
             (end_year > start_year) OR
             (end_year = start_year AND COALESCE(end_month,12) >= COALESCE(start_month,1)))
      CHECK (NOT is_current OR (end_year IS NULL AND end_month IS NULL))
  '''
}

Table application_educations {
  id uuid [pk]
  application_id uuid [not null]

  institution varchar [not null]
  degree varchar
  field_of_study varchar
  graduation_year int

  description text
  sort_order int [not null, default: 0]

  indexes {
    application_id
    (application_id, graduation_year)
    (application_id, sort_order)
  }

  Note: '''
    Immutable application-time education data. It may originate from the global
    profile or a reviewed alternate-CV form. Education is not an automatic
    screening criterion in the MVP.

    CHECK constraints (add in migration):
      CHECK (graduation_year IS NULL OR graduation_year BETWEEN 1900 AND 2100)
  '''
}

Table application_skills {
  application_id uuid [not null]
  taxonomy_id uuid [not null]

  years_experience decimal(4,1)
  sort_order int [not null, default: 0]

  indexes {
    (application_id, taxonomy_id) [pk]
    (taxonomy_id, application_id)
    (application_id, sort_order)
  }

  Note: '''
    Immutable application-time skill data used for screening. It may originate
    from the global profile or a reviewed alternate-CV form.

    CHECK constraints (add in migration):
      CHECK (years_experience IS NULL OR years_experience >= 0)
  '''
}

Table application_projects {
  id uuid [pk]
  application_id uuid [not null]

  name varchar [not null]
  description text

  project_url text
  repository_url text

  start_year int
  start_month int
  end_year int
  end_month int

  sort_order int [not null, default: 0]

  indexes {
    application_id
    (application_id, sort_order)
  }

  Note: '''
    Immutable application-time project data. It may originate from the global
    profile or a reviewed alternate-CV form.

    CHECK constraints (add in migration):
      CHECK (start_month IS NULL OR start_month BETWEEN 1 AND 12)
      CHECK (end_month   IS NULL OR end_month   BETWEEN 1 AND 12)
      CHECK (start_year IS NULL OR end_year IS NULL OR
             (end_year > start_year) OR
             (end_year = start_year AND COALESCE(end_month,12) >= COALESCE(start_month,1)))
  '''
}

Table application_languages {
  application_id uuid [not null]
  language_code varchar [not null]

  proficiency language_proficiency [not null]
  sort_order int [not null, default: 0]

  indexes {
    (application_id, language_code) [pk]
    (language_code, application_id)
    (application_id, sort_order)
  }

  Note: '''
    Immutable application-time language data used for screening. It may
    originate from the global profile or a reviewed alternate-CV form.
  '''
}

Table application_answers {
  application_id uuid [not null]
  job_id uuid [not null]
  question_id uuid [not null]

  answer_boolean boolean
  answer_text text

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, question_id) [pk]
    (job_id, question_id)
  }

  Note: '''
    Immutable candidate answers captured during application submission.

    The trusted submission RPC validates every required question, verifies that
    the answer field matches the referenced question type, rejects answers for
    another job, and writes applications, application snapshots and answers in
    one transaction.

    PostgreSQL migration constraint:
      CHECK (
        (answer_boolean IS NOT NULL AND answer_text IS NULL) OR
        (answer_boolean IS NULL AND answer_text IS NOT NULL)
      )
  '''
}

Table application_notes {
  id uuid [pk]

  tenant_id uuid [
    not null,
    note: 'Must equal both the application tenant and the recruiter tenant; enforced by composite FKs below.'
  ]
  application_id uuid [not null]
  recruiter_id uuid [not null]

  note_text text [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, created_at)
    (tenant_id, recruiter_id)
  }

  Note: '''
    The composite foreign keys guarantee that the application and author
    recruiter belong to the same tenant, rather than trusting RLS alone.
  '''
}

Table application_status_history {
  id uuid [pk]

  application_id uuid [not null]

  change_source status_change_source [not null]
  changed_by_profile_id uuid

  previous_status application_status
  new_status application_status [not null]

  reason text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, created_at)
  }
}

Table application_qualification_history {
  id uuid [pk]

  application_id uuid [not null]

  qualification_status qualification_status [not null]
  qualification_reason text

  screening_version varchar [
    note: 'Identifier of the deterministic screening ruleset that produced this verdict.'
  ]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, created_at)
  }

  Note: '''
    Append-only, authoritative record of every screening evaluation for an application.
    Re-running screening inserts a new row here and updates the denormalized
    applications.qualification_* to the latest verdict. This preserves point-in-time
    explanations of why a candidate was qualified/disqualified.
  '''
}

/* -------------------------------------------------------------------------- */
/* Communication and analytics                                                 */
/* -------------------------------------------------------------------------- */

Table communications {
  id uuid [pk]

  tenant_id uuid [
    note: '''
      Tenant responsible for the communication. NULL only for platform-level
      automatic messages such as a candidate-owned CV parsing failure.
    '''
  ]

  candidate_id uuid [not null]
  application_id uuid

  initiated_by_recruiter_id uuid [
    note: '''
      NULL for automatic system messages. When set, application_id is mandatory
      and the recruiter must belong to the application's tenant.
    '''
  ]

  channel communication_channel [not null]
  communication_type communication_type [not null]

  status communication_status [not null, default: 'queued']

  recipient varchar [
    not null,
    note: 'The actual address or number used for this message, retained for delivery audit.'
  ]

  subject varchar
  payload jsonb [not null]

  attempts int [not null, default: 0]
  error_message text

  provider varchar
  provider_message_id varchar

  template_key varchar
  idempotency_key varchar [not null, unique]

  created_at timestamptz [not null, default: `now()`]
  sent_at timestamptz

  indexes {
    (status, created_at)
    candidate_id
    application_id
    (tenant_id, candidate_id, created_at)
    (tenant_id, application_id, created_at)
    (tenant_id, initiated_by_recruiter_id)
    (provider, provider_message_id) [unique]
  }

  Note: '''
    Application-linked messages composite-FK both the candidate and tenant, so a
    message cannot be attached to another candidate's application or another
    tenant's application.

    Recruiter-initiated communication is application-only. Recruiters cannot send
    outreach from global candidate search. Automatic platform messages may omit
    application_id and tenant_id.

    (provider, provider_message_id) is unique only once both are assigned (NULLs are distinct),
    so queued rows without a provider id do not collide.

    PostgreSQL migration constraints:
      CHECK (attempts >= 0)
      CHECK (application_id IS NULL OR tenant_id IS NOT NULL)
      CHECK (initiated_by_recruiter_id IS NULL OR tenant_id IS NOT NULL)
      CHECK (initiated_by_recruiter_id IS NULL OR application_id IS NOT NULL)
      CHECK (
        tenant_id IS NOT NULL OR
        (application_id IS NULL AND initiated_by_recruiter_id IS NULL)
      )
  '''
}

Table job_view_events {
  id bigint [pk, increment]

  job_id uuid [not null]

  tracked_link_id uuid [
    note: 'NULL when the visitor used the ordinary untracked job URL.'
  ]

  session_id varchar
  visitor_hash varchar

  viewed_at timestamptz [not null, default: `now()`]

  indexes {
    (job_id, viewed_at)
    (tracked_link_id, viewed_at)
    (job_id, tracked_link_id, viewed_at)
  }

  Note: '''
    Append-only record of job-page views.

    tracked_link_id identifies the recruiter-created link used to reach the job.
    It is NULL for direct, untracked visits.

    The composite foreign key ensures that the tracked link belongs to the job
    recorded on this event.

    Recommended in migration: RANGE partition by viewed_at, such as monthly,
    and remove old partitions according to the analytics-retention policy.
  '''
}

/* -------------------------------------------------------------------------- */
/* Tenant candidate CRM                                                        */
/* -------------------------------------------------------------------------- */

Table candidate_notes {
  id uuid [pk]

  tenant_id uuid [not null]
  candidate_id uuid [not null]
  recruiter_id uuid [not null]

  note_text text [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, candidate_id, created_at)
    recruiter_id
  }
}

Table tenant_tags {
  id uuid [pk]
  tenant_id uuid [not null]

  name varchar [not null]
  scope tag_scope [not null]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, scope, name) [unique]
    (tenant_id, id) [unique]
  }
}

Table candidate_tag_assignments {
  tenant_id uuid [not null]
  candidate_id uuid [not null]
  tag_id uuid [not null]

  added_by_recruiter_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (candidate_id, tag_id) [pk]
    (tenant_id, candidate_id)
  }
}

Table application_tag_assignments {
  tenant_id uuid [not null]
  application_id uuid [not null]
  tag_id uuid [not null]

  added_by_recruiter_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, tag_id) [pk]
    (tenant_id, application_id)
  }

  Note: '''
    tenant_id now composite-FKs the application (tenant_id, application_id) -> applications
    (tenant_id, id), in addition to the tag and recruiter, so all three are provably in the
    same tenant.
  '''
}

/*
  Each tenant has one implicit talent pool for now.
  The composite primary key prevents the same candidate from appearing more than once.
*/

Table talent_pool_members {
  tenant_id uuid [not null]
  candidate_id uuid [not null]

  added_by_recruiter_id uuid [not null]
  added_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, candidate_id) [pk]
    candidate_id
  }
}

/* -------------------------------------------------------------------------- */
/* Tracked job-link attribution                                                */
/* -------------------------------------------------------------------------- */


Table tracked_job_links {
  id uuid [pk]
  tenant_id uuid [not null]
  job_id uuid [not null]
  created_by_recruiter_id uuid [not null]

  name varchar [
    not null,
    note: 'Recruiter-defined label such as LinkedIn, Ahmed Referral, or July Campaign.'
  ]

  token varchar [
    not null,
    unique,
    note: 'Random unguessable token included in the public job URL.'
  ]

  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz

  indexes {
    (tenant_id, job_id, name) [unique]
    (tenant_id, id) [unique]
    (job_id, is_active)
    (job_id, id) [unique]
    created_by_recruiter_id
  }
}

Table application_ai_match_assessments {
  id uuid [pk]
  application_id uuid [not null]

  match_percentage decimal(5,2) [not null]
  explanation text
  assessment_details jsonb

  model_name varchar [not null]
  prompt_version varchar [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, created_at)
  }

  Note: '''
    Advisory AI comparison between the immutable application snapshot and job
    description. It never overrides deterministic qualification_status.

    PostgreSQL migration constraint:
      CHECK (match_percentage BETWEEN 0 AND 100)
  '''
}

Ref: applications.id < application_ai_match_assessments.application_id

/*
Supabase RLS policy intent:

* auth.users: recruiter clients never query this table. Only trusted backend
  services resolve the candidate's current verified email for delivery.

* profiles and candidates: candidates may read and update only rows where
  id = auth.uid(). Recruiters do not receive direct table access for global
  search; a trusted projection exposes only approved public fields.

* candidate_experiences, candidate_educations, candidate_skills,
  candidate_projects and candidate_languages: a candidate may insert,
  update or delete only rows whose candidate_id = auth.uid().

* cvs: a candidate may upload and read only CVs where
  candidate_id = auth.uid(). Only the trusted parsing worker may update
  parsing_status, parsed_cv_data, parsing_error and parsed_at.

* global candidate search: only the trusted search view or endpoint may return
  opted-in candidates. It enforces the complete eligibility predicate documented
  on candidates, returns only current profile-version chunks, and excludes email,
  phone, applications, communications, and every tenant's notes and tags.

* applications, application_profile_snapshots and all application_* child tables:
  no direct client writes. A trusted submission transaction/RPC creates an
  application only for auth.uid(), validates a ready non-deleted candidate-owned
  CV, validates required questions and answer types, and writes all immutable
  application-time rows atomically.

  The confirmed data may come from either:

  1. the candidate's current candidate_* profile tables; or
  2. a reviewed application-specific CV form.

  The RPC may optionally update the candidate's global candidate_* profile
  when the candidate explicitly selects "Also update my global profile".

* active tenant recruiters: recruiters.is_active must be true. Every active
  recruiter in a tenant may read that tenant's applications, application notes,
  application and candidate tags, candidate notes, talent-pool membership and
  communication history. recruiter_id and added_by_recruiter_id identify authors;
  they do not make rows private.

* cross-tenant isolation: recruiters never read or mutate another tenant's
  applications, notes, tags, talent-pool rows or communications.

* recruiter mutations: recruiters may update permitted application workflow
  state and create shared tenant CRM rows, but may never modify candidate-owned
  profile data or immutable application snapshots and answers.

* communications: trusted backend operations resolve the verified auth email,
  store the exact delivered address in recipient, and enforce tenant ownership.
  A recruiter-initiated row requires an application_id and the recruiter,
  application and communication must all belong to the same tenant. There is no
  recruiter outreach from global candidate search.

* job screening configuration: trusted job-management operations lock
  minimum_total_experience_years, job_skills, job_languages and
  job_application_questions after the first application.

* screening workers may read application_profile_snapshots and application_*
  child tables, but must not use the current candidate_* profile tables when
  evaluating an existing application. They apply only the deterministic rules
  documented on applications. New verdicts are appended to
  application_qualification_history and mirrored onto applications.qualification_*.

Note: the schema-level tenant composite FKs are a backstop, not a replacement,
for these RLS policies. Both should be present.
  */


/* -------------------------------------------------------------------------- */
/* Relationships: identity                                                     */
/* -------------------------------------------------------------------------- */

Ref: auth.users.id - profiles.id
Ref: profiles.id - candidates.id
Ref: profiles.id - recruiters.id

Ref: languages.code < candidates.preferred_language_code

/* -------------------------------------------------------------------------- */
/* Relationships: tenants and jobs                                             */
/* -------------------------------------------------------------------------- */

Ref: tenants.id < recruiters.tenant_id

Ref: jobs.(tenant_id, created_by_recruiter_id)
  > recruiters.(tenant_id, id)

Ref: tenants.id < jobs.tenant_id
Ref: jobs.id < job_skills.job_id
Ref: skill_taxonomy.id < job_skills.taxonomy_id
Ref: skill_categories.id < skill_taxonomy.category_id
Ref: jobs.id < job_languages.job_id
Ref: languages.code < job_languages.language_code
Ref: jobs.id < job_application_questions.job_id

/* -------------------------------------------------------------------------- */
/* Relationships: CVs and current candidate profile                            */
/* -------------------------------------------------------------------------- */

Ref: candidates.id < cvs.candidate_id
Ref: cvs.id - ingestion_jobs.cv_id

// Guarantees ownership of the selected current CV.
// ON DELETE RESTRICT: CVs are soft-deleted, so a current CV is never hard-deleted out from under a candidate.
Ref: candidates.(id, current_cv_id)
  > cvs.(candidate_id, id) [delete: restrict]

Ref: candidates.id < candidate_experiences.candidate_id
Ref: candidates.id < candidate_educations.candidate_id
Ref: candidates.id < candidate_skills.candidate_id
Ref: candidates.id < candidate_projects.candidate_id
Ref: candidates.id < candidate_languages.candidate_id

Ref: skill_taxonomy.id < candidate_skills.taxonomy_id
Ref: languages.code < candidate_languages.language_code

Ref: candidates.id < candidate_profile_chunks.candidate_id

/* -------------------------------------------------------------------------- */
/* Relationships: applications                                                 */
/* -------------------------------------------------------------------------- */

Ref: candidates.id < applications.candidate_id

// Tenant isolation: the application and its job must share one tenant.
Ref: applications.(tenant_id, job_id)
  > jobs.(tenant_id, id)



Ref: tenants.id < applications.tenant_id

// Guarantees that the submitted CV belongs to the applying candidate.
Ref: applications.(candidate_id, cv_id)
  > cvs.(candidate_id, id)

Ref: applications.id - application_profile_snapshots.application_id
Ref: applications.id < application_experiences.application_id
Ref: applications.id < application_educations.application_id
Ref: applications.id < application_skills.application_id
Ref: applications.id < application_projects.application_id
Ref: applications.id < application_languages.application_id

Ref: skill_taxonomy.id < application_skills.taxonomy_id
Ref: languages.code < application_languages.language_code

// Answers must belong to both this application job and this job's question.
Ref: application_answers.(job_id, application_id)
  > applications.(job_id, id)

Ref: application_answers.(job_id, question_id)
  > job_application_questions.(job_id, id)

// application_notes: note, its application, and its author recruiter are all one tenant.
Ref: application_notes.(tenant_id, application_id)
  > applications.(tenant_id, id)
Ref: application_notes.(tenant_id, recruiter_id)
  > recruiters.(tenant_id, id)

Ref: applications.id < application_status_history.application_id
Ref: profiles.id < application_status_history.changed_by_profile_id

Ref: applications.id < application_qualification_history.application_id

/* -------------------------------------------------------------------------- */
/* Relationships: communication and analytics                                 */
/* -------------------------------------------------------------------------- */

Ref: candidates.id < communications.candidate_id
Ref: tenants.id < communications.tenant_id

// Application-linked messages must match both the candidate and tenant.
Ref: communications.(application_id, candidate_id)
  > applications.(id, candidate_id)

Ref: communications.(tenant_id, application_id)
  > applications.(tenant_id, id)

// A recruiter-initiated message must be authored by a recruiter in the same tenant.
Ref: communications.(tenant_id, initiated_by_recruiter_id)
  > recruiters.(tenant_id, id)

Ref: jobs.id < job_view_events.job_id

// Prevents recording a tracked link belonging to a different job.
Ref: job_view_events.(job_id, tracked_link_id)
  > tracked_job_links.(job_id, id)

Ref: tenants.id < tracked_job_links.tenant_id

Ref: tracked_job_links.(tenant_id, job_id)
  > jobs.(tenant_id, id)

Ref: tracked_job_links.(tenant_id, created_by_recruiter_id)
  > recruiters.(tenant_id, id)

Ref: applications.(job_id, tracked_link_id)
  > tracked_job_links.(job_id, id)

/* -------------------------------------------------------------------------- */
/* Relationships: tenant CRM                                                   */
/* -------------------------------------------------------------------------- */

Ref: tenants.id < candidate_notes.tenant_id
Ref: candidates.id < candidate_notes.candidate_id

Ref: candidate_notes.(tenant_id, recruiter_id)
  > recruiters.(tenant_id, id)

Ref: tenants.id < talent_pool_members.tenant_id
Ref: candidates.id < talent_pool_members.candidate_id

Ref: talent_pool_members.(tenant_id, added_by_recruiter_id)
  > recruiters.(tenant_id, id)

Ref: tenants.id < tenant_tags.tenant_id

Ref: candidates.id < candidate_tag_assignments.candidate_id

Ref: candidate_tag_assignments.(tenant_id, tag_id)
  > tenant_tags.(tenant_id, id)

Ref: candidate_tag_assignments.(tenant_id, added_by_recruiter_id)
  > recruiters.(tenant_id, id)

// application_tag_assignments: assignment, its application, its tag, and its author are one tenant.
Ref: application_tag_assignments.(tenant_id, application_id)
  > applications.(tenant_id, id)

Ref: application_tag_assignments.(tenant_id, tag_id)
  > tenant_tags.(tenant_id, id)

Ref: application_tag_assignments.(tenant_id, added_by_recruiter_id)
  > recruiters.(tenant_id, id)
